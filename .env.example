# Copie para .env e ajuste se necessário. O .env não é versionado.
POSTGRES_DB=parlamento
POSTGRES_USER=parlamento
POSTGRES_PASSWORD=parlamento
# 5433 para não colidir com um PostgreSQL instalado localmente na 5432
POSTGRES_PORT=5433
# Porta da API no host
API_PORT=8080

# Chave exigida no header X-Admin-Key dos endpoints /admin. Vazia = administração bloqueada.
# Gere uma aleatória, por exemplo: openssl rand -hex 32
ADMIN_API_KEY=
# Origens do frontend autorizadas (CORS), separadas por vírgula
CORS_ORIGINS=http://localhost:5173
